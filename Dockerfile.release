# Build a GameHub self-update release bundle INSIDE the Linux runtime, so the
# bundled native modules (better-sqlite3, sharp) are linux-x64 binaries that
# match the container. Exports dist/ (gamehub-<version>.zip + .sha256 +
# latest.json) to the host:
#
#   docker build -f Dockerfile.release --target export --output type=local,dest=./dist .
#
# vita-pfsdec (PS Vita dump decryption, tools/vita-pfsdec) is built statically and
# shipped in the bundle as bin/vita-pfsdec, so in-app updates bring it to images
# that predate it.
FROM debian:bookworm-slim AS vitatools
RUN apt-get update \
  && apt-get install -y --no-install-recommends build-essential cmake git ca-certificates libssl-dev zlib1g-dev \
  && rm -rf /var/lib/apt/lists/*
COPY tools/vita-pfsdec /src/vita-pfsdec
RUN cmake -S /src/vita-pfsdec -B /build -DCMAKE_BUILD_TYPE=Release \
  && cmake --build /build -j"$(nproc)" \
  && strip /build/vita-pfsdec

FROM node:22-bookworm-slim AS relbuild
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
COPY --from=vitatools /build/vita-pfsdec /app/.release-bin/vita-pfsdec
ENV NEXT_TELEMETRY_DISABLED=1
ENV BUILD_STANDALONE=1
RUN npm run build && npm run release

# Export stage: only the dist/ artifacts, copied to the host via --output.
FROM scratch AS export
COPY --from=relbuild /app/dist /
